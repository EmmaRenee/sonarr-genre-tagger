# Copy this file to .env and fill in your actual values
# IMPORTANT: .env should NEVER be committed to git
# Add .env to .gitignore if not already present

# Sonarr Configuration (Required)
SONARR_URL=http://sonarr:8989/api
SONARR_API=your-sonarr-api-key-here

# Radarr Configuration (Optional)
RADARR_URL=http://radarr:7878/api
RADARR_API=your-radarr-api-key-here

